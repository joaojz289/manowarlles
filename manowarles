/* ======================== UTILITARIOS ======================== */

void limpar_tela() {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

void pausar() {
    printf("\n  Pressione ENTER para continuar...");
    getchar();
    getchar();
}

void linha(int n)  { for (int i=0;i<n;i++) printf("="); printf("\n"); }
void linhaf(int n) { for (int i=0;i<n;i++) printf("-"); printf("\n"); }

int proximo_id(const char *arq, size_t tam) {
    FILE *f = fopen(arq, "rb");
    if (!f) return 1;
    fseek(f, 0, SEEK_END);
    long sz = ftell(f);
    fclose(f);
    return (int)(sz / tam) + 1;
}

void timestamp(char *buf, int bufsz) {
    time_t t = time(NULL);
    struct tm *tm = localtime(&t);
    strftime(buf, bufsz, "%d/%m/%Y %H:%M:%S", tm);
}

/* ======================== GERAR TXT ======================== */

void escola_gerar_txt() {
    Aluno a;
    char ts[30];
    timestamp(ts, sizeof(ts));
    FILE *dat = fopen(ARQ_ESCOLA, "rb");
    FILE *txt = fopen(TXT_ESCOLA, "w");
    if (!txt) return;
    fprintf(txt, "============================================================\n");
    fprintf(txt, "  RELATORIO - ESCOLA\n");
    fprintf(txt, "  Gerado em: %s\n", ts);
    fprintf(txt, "============================================================\n\n");
    int count = 0;
    if (dat) {
        while (fread(&a, sizeof(Aluno), 1, dat)) {
            count++;
            fprintf(txt, "  ID        : %d\n", a.id);
            fprintf(txt, "  Nome      : %s\n", a.nome);
            fprintf(txt, "  CPF       : %s\n", a.cpf);
            fprintf(txt, "  Telefone  : %s\n", a.telefone);
            fprintf(txt, "  Matricula : %s\n", a.matricula);
            fprintf(txt, "  Curso     : %s\n", a.curso);
            fprintf(txt, "------------------------------------------------------------\n");
        }
        fclose(dat);
    }
    fprintf(txt, "\n  Total de alunos: %d\n", count);
    fclose(txt);
}

