/* ======================== LOGIN ======================== */

#define USUARIO "admin"
#define SENHA   "1234"

int fazer_login() {
    char u[30], s[30];
    int tentativas = 3;
    while (tentativas > 0) {
        limpar_tela(); linha(44);
        printf("         LOGIN DO SISTEMA\n"); linha(44);
        printf("  Usuario : "); scanf(" %29[^\n]", u);
        printf("  Senha   : "); scanf(" %29[^\n]", s);
        if (strcmp(u, USUARIO)==0 && strcmp(s, SENHA)==0) {
            printf("\n  Login realizado com sucesso!\n");
            pausar();
            return 1;
        }
        tentativas--;
        printf("\n  Usuario ou senha incorretos!");
        if (tentativas > 0) printf(" Tentativas restantes: %d\n", tentativas);
        else printf("\n");
        pausar();
    }
    printf("\n  Tentativas esgotadas. Encerrando...\n");
    return 0;
}

